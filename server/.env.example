PORT = port number
MONGO_URI = MONGO_URI Atlas from mongodb
jwtSecretKey = jsonwebtoken SecretKey
REDIS_URL= your redis url
TWILIO_ACCOUNT_SID = account ssid
TWILIO_AUTH_TOKEN = auth token
PAYSTACK_SECRET_KEY = your secret key
CONTENT_SID = your content sid
FRONTEND_URL = your frontend url
